generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String  @id
  email                  String  @unique
  passwordHash           String  @default("") @db.Text
  name                   String
  role                   String  @default("client")
  bio                    String? @db.Text
  avatar                 String?
  createdAt              String
  setPasswordToken       String?
  setPasswordTokenExpiry String?
  emailVerified          Boolean @default(false)
  verificationToken      String?
  verificationTokenExpiry String?
  instagram              String?
  pseudo                 String?
  universe               String?

  @@map("users")
}

model BrandCategory {
  id             String  @id
  universe       String
  label          String
  slug           String
  latin          String?
  description    String?
  primaryImageId String?
  hoverImageId   String?
  order          Int     @default(0)

  @@unique([universe, slug])
  @@map("brand_categories")
}

model BrandSlide {
  id        String  @id
  universe  String
  type      String  @default("image")
  mediaId   String?
  title     String?
  subtitle  String?
  order     Int     @default(0)
  createdAt String

  @@map("brand_slides")
}

model Product {
  id           String  @id
  name         String
  description  String  @db.Text
  price        Int
  universe     String
  category     String
  images       String  @db.Text
  stock        Int
  status       String
  serialNumber String?
  dimensions   String? @db.Text
  materials    String? @db.Text
  video        String?
  createdBy    String?
  createdAt    String
  updatedAt    String

  @@map("products")
}

model ProductImage {
  id       String @id
  data     Bytes  @db.LongBlob
  mimeType String

  @@map("product_images")
}

model Order {
  id              String      @id
  customerName    String
  customerEmail   String
  customerPhone   String?
  shippingAddress String      @db.Text
  shippingMethod  String
  shippingCost    Int
  subtotal        Int
  total           Int
  status          String      @default("en_attente")
  stripeSessionId String?     @unique
  boxtalRef       String?
  notes           String?     @db.Text
  createdAt       String
  updatedAt       String
  items           OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String @id
  orderId   String
  productId String
  name      String
  price     Int
  quantity  Int
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model NewsletterSubscriber {
  id           String @id
  email        String @unique
  subscribedAt String

  @@map("newsletter_subscribers")
}

model SiteSetting {
  key   String @id
  value String @db.Text

  @@map("site_settings")
}
