# Copier vers .env.local. Ne jamais commiter de vraies valeurs.
# Mot de passe UNIQUEMENT alphanumérique (Hostinger déforme # ! % @). Voir docs/rotation-des-mots-de-passe.md
DATABASE_URL=postgresql://postgres.REFERENCE:MOT_DE_PASSE@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
SESSION_SECRET=            # 32 caractères minimum : openssl rand -hex 32
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SHIPPING_FLAT_CENTS=0                 # frais de port en centimes, 0 = offerts
FREE_SHIPPING_THRESHOLD_CENTS=0       # seuil de livraison offerte, 0 = aucun

SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

NEXT_PUBLIC_GA_ID=                    # optionnel, chargé après consentement uniquement

MEDIATOR_NAME=
MEDIATOR_URL=
MEDIATOR_ADDRESS=

# Appliquer le schéma Prisma à la base au prochain build : 1 (à retirer ensuite)
PRISMA_DB_PUSH=
