# Copier vers .env.local. Ne jamais commiter de vraies valeurs.
DATABASE_URL=
SESSION_SECRET=            # 32 caractères minimum : openssl rand -hex 32
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
