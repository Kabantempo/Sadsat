FREE_SHIPPING_THRESHOLD_CENTS=0       # seuil de livraison offerte, 0 = aucun

SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

NEXT_PUBLIC_GA_ID=                    # optionnel, chargé après consentement uniquement

MEDIATOR_NAME=
